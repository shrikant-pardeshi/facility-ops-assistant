# Copy to .env and fill in. NEVER commit .env.

# ---- LLM provider: "gemini" (default) or "openai" --------------------------
LLM_PROVIDER=gemini

# Google Gemini - get a key at https://aistudio.google.com/app/apikey
# Either variable name works: GOOGLE_API_KEY or GEMINI_API_KEY.
# Model IDs change over time; see https://ai.google.dev/gemini-api/docs/models
# (gemini-2.5-* is now limited-access for new users).
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI (optional alternative) - https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LLM_TEMPERATURE=0
LLM_TIMEOUT_S=30

# ---- Paths (relative to project root) -------------------------------------
SEED_DIR=data/seed
KB_DIR=data/knowledge_base
DB_PATH=data/facility_ops.db
LOG_DIR=logs
LOG_LEVEL=INFO

# ---- Business rules --------------------------------------------------------
# Pin "today" so compliance/AMC statuses in the demo are reproducible.
# The sample data is designed around 2026-10-01. Leave blank for the real date.
AS_OF_DATE=2026-10-01
DUE_SOON_DAYS=30
UPCOMING_DAYS=90
COVERAGE_EXPIRING_DAYS=60
KB_TOP_K=8
KB_MIN_SCORE=2.0
